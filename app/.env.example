# Copy this file to .env before building/dev — Vite only reads .env, never
# this file, and .env is gitignored so it won't survive a fresh clone.
# These are the mn-kpi-dashboard project's actual values (a Firebase web
# app's client-side config is meant to be public — it's embedded in every
# page load's JS bundle regardless — so committing it here is safe and
# means a deploy from a freshly cloned checkout never again ships without
# it, which once caused a real outage: the built site silently fell back
# to "local only" mode with no Firestore sync for any user).
VITE_FIREBASE_API_KEY=AIzaSyCc--uO0QNzLCA4SAKCLHgO1w_ObUoUj6A
VITE_FIREBASE_AUTH_DOMAIN=mn-kpi-dashboard.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mn-kpi-dashboard
VITE_FIREBASE_STORAGE_BUCKET=mn-kpi-dashboard.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=177041641000
VITE_FIREBASE_APP_ID=1:177041641000:web:f59b522211e3ed015bef1d
